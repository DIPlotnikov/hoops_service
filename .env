# === Django ===
DEV=true
DEBUG=True
SECRET_KEY=dev-secret-key
CSRF_TRUSTED_ORIGINS_KEY=http://localhost:18000

# === MySQL container (db_mysql) ===
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=hoops
MYSQL_USER=hoops
MYSQL_PASSWORD=hoops

# === PostgreSQL container (db) — не используется приложением, но требуется сервису ===
POSTGRES_DB=hoops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# === App settings ===
# Django будет читать конфиг подключения к MySQL из этого файла (монтируется как ./core:/code)
MYSQL_CONFIG=/code/configs/mysql.cnf

# Redis URL для Celery и Django
REDIS_URL=redis://redis:6379/0

# === MINIO (опционально) ===
MINIO_SERVER=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=hoops
MINIO_PREFIX=
